---
import { env } from 'cloudflare:workers';
import Store from '../../layouts/Store.astro';
import SignIn from '../../components/SignIn.astro';
import Notice from '../../components/Notice.astro';
import { currentUser, emailReady } from '../../lib/auth.js';
import { unifiedOrders, orderHref, orderReference } from '../../lib/order-history.js';
import { displayDate, money } from '../../lib/content.js';
import { shippingRates } from '../../lib/checkout.js';
const user = await currentUser(env, Astro);
const offset = Math.max(0, Math.min(10000, Number.parseInt(Astro.url.searchParams.get('offset') ?? '0', 10) || 0));
const orders = user ? await unifiedOrders(env.DB,{email:user.email,offset}) : [];
const profile = user ? await env.DB.prepare('SELECT * FROM customer_profiles WHERE customer_id=?').bind(user.id).first() : null;
const rates = user ? await shippingRates(env.DB) : [];
---
<Store title="My account" noIndex>
  <section class="store-checkout">
    <h1>MY ACCOUNT</h1>
    {user ? <>
      <Notice success={Astro.url.searchParams.has('saved') ? 'Your profile has been saved.' : null} />
      <p>{user.email}</p>
      <details class="profile-form"><summary>Manage my information</summary>
        <form method="post" action="/account/session" class="form">
          <input type="hidden" name="action" value="profile" />
          <label>Full name<input name="name" autocomplete="name" maxlength="100" required value={user.name} /></label>
          <label>Phone<input name="phone" type="tel" autocomplete="tel" maxlength="24" value={profile?.phone} /></label>
          <label>Street, building and apartment<textarea name="address" autocomplete="street-address" maxlength="350">{profile?.address}</textarea></label>
          <label>City or district<input name="city" autocomplete="address-level2" maxlength="100" value={profile?.city} /></label>
          <label>Governorate<select name="governorate" autocomplete="address-level1"><option value="">Choose governorate</option>{rates.map(rate => <option value={rate.code} selected={profile?.governorate === rate.code}>{rate.label}</option>)}</select></label>
          <p>Your verified email identifies your order history. To use another email, sign out and verify that address.</p>
          <button class="btn" type="submit">SAVE MY INFORMATION</button>
        </form>
      </details>
      <p><a class="btn" href="/returns">RETURNS, EXCHANGES & STORE CREDIT</a></p>
      <h2>Orders</h2>
      {orders.length ? <ul class="account-orders">{orders.slice(0,25).map(order => <li>
        <a href={orderHref(order)}>Order {orderReference(order)}</a> · {displayDate(order.created_at)} · {order.currency === 'EGP' ? money(order.total,true) : (order.total/100).toFixed(2) + ' ' + order.currency} · {order.status} · {order.payment_status}
      </li>)}</ul> : <p>No orders yet.</p>}
      <p>{offset > 0 && <a href={'/account?offset=' + Math.max(0,offset-25)}>Previous</a>} {orders.length>25 && <a href={'/account?offset=' + (offset+25)}>Next</a>}</p>
      <form method="post" action="/account/session"><input type="hidden" name="action" value="logout" /><button class="btn" type="submit">SIGN OUT</button></form>
    </> : <><p>Create your UNLISTED account or sign in with a secure email link. Use the email from your orders to see your complete history.</p><SignIn purpose="account" ready={emailReady(env)} /></>}
  </section>
</Store>
