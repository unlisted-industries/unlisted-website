---
import { env } from 'cloudflare:workers';
import Admin from '../../layouts/Admin.astro';
import { passwordRecord, passwordsReady } from '../../lib/admin-password.js';
import { currentUser } from '../../lib/auth.js';
import { unixNow } from '../../lib/db.js';

const user = await currentUser(env, Astro, 'admin');
if (!user) return Astro.redirect('/admin/login', 303);
if (!passwordsReady(env, Astro.url)) return Astro.redirect('/admin', 303);
const hasPassword = Boolean(await passwordRecord(env.DB, user.email));
const requireCurrent = hasPassword && user.password_change_until <= unixNow();
const title = requireCurrent ? 'Change password' : 'Set your password';
---
<Admin title={title} user={user}>
  <div class="panel password-panel">
    <h1>{title}</h1>
    <p>Choose a password with 15 to 128 characters.</p>
    <form method="post" action="/admin/session" class="admin-form">
      <input type="hidden" name="action" value="save-password" />
      {requireCurrent && <label>Current password <input name="current_password" type="password" autocomplete="current-password" maxlength="256" required /></label>}
      <label>New password <input name="password" type="password" autocomplete="new-password" minlength="15" maxlength="256" required /></label>
      <label>Confirm password <input name="password_confirmation" type="password" autocomplete="new-password" minlength="15" maxlength="256" required /></label>
      <button class="btn" type="submit">SAVE PASSWORD</button>
    </form>
  </div>
</Admin>
