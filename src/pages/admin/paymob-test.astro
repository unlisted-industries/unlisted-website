---
import { env } from 'cloudflare:workers';
import Admin from '../../layouts/Admin.astro';
import PaymobSandbox from '../../components/PaymobSandbox.astro';
import { currentUser } from '../../lib/auth.js';
import { paymentIntegrationIds } from '../../lib/paymob.js';
import { prepareSandboxPage } from '../../lib/paymob-sandbox.js';

const user = await currentUser(env, Astro, 'admin');
if (!user) return Astro.redirect('/admin/login', 303);
const state = await prepareSandboxPage(env, Astro, '/admin/paymob-test');
---
<Admin title="Paymob sandbox" user={user}>
  <div class="admin-heading"><div><p class="overline">PAYMENTS</p><h1>Paymob sandbox</h1></div></div>
  <PaymobSandbox {...state} action="/admin/paymob-test" integrations={paymentIntegrationIds(env)} />
</Admin>
