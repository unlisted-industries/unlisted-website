---
import { env } from 'cloudflare:workers';
import Admin from '../../layouts/Admin.astro';
import FinanceForm from '../../components/admin/FinanceForm.astro';
import { currentUser,emailReady } from '../../lib/auth.js';
import { money } from '../../lib/content.js';
import { moneyKinds,expenseCategories } from '../../lib/finance.js';
import { financeReport } from '../../lib/finance-report.js';
import { metaReady } from '../../lib/finance-meta.js';
import { dateRangeLabel,metricChange } from '../../lib/reporting.js';
import { makeToken } from '../../lib/db.js';
const user=await currentUser(env,Astro,'admin');if(!user)return Astro.redirect('/admin/login',303);
const f=await financeReport(env.DB,Astro.url),today=f.range.today;
const tabs=[['overview','Overview'],['accountant','AI accountant'],['cash','Cash & ledger'],['drops','Drops & production'],['inventory','Inventory & PR'],['marketing','Marketing'],['planning','Planning'],['settings','Alerts & controls']];
const tab=tabs.some(([key])=>key===Astro.url.searchParams.get('tab'))?Astro.url.searchParams.get('tab'):'overview';
const link=key=>'/admin/finance?'+new URLSearchParams({...Object.fromEntries(Astro.url.searchParams),tab:key});
const accounts=[['bank','Bank'],['cash','Cash'],['unallocated','Unreconciled']];
const variantOptions=f.variants.map(v=>[v.id,v.product+' / '+v.title]);
const dropOptions=[['','General business'],...f.drops.map(d=>[d.id,d.name])];
const amount=(name='amount',label='Amount (EGP)',value=undefined)=>({name,label,type:'number',min:0,step:'0.01',max:1000000,value});
const date=(name='occurred_on')=>({name,label:'Date',type:'date',value:today,max:today});
const text=(name,label,required=true)=>({name,label,required});
const select=(name,label,options)=>({name,label,options});
const error=Astro.url.searchParams.get('error');
const selectedImport=f.imports.find(i=>i.id===Astro.url.searchParams.get('import'));
const extracted=selectedImport?JSON.parse(selectedImport.extracted):null;
const chartMax=Math.max(1,...f.trend.flatMap(d=>[d.revenue,d.expenses]));
const points=key=>f.trend.map((d,n)=>`${(n/Math.max(1,f.trend.length-1))*700},${180-160*d[key]/chartMax}`).join(' ');
const adviceId=Astro.url.searchParams.get('advice');
const advice=/^[a-f0-9]{32}$/.test(adviceId||'')?await env.DB.prepare('SELECT * FROM finance_advice WHERE id=?').bind(adviceId).first():null;
const emailSent=await env.DB.prepare("SELECT max(sent_at) sent_at FROM finance_email_outbox WHERE state='sent'").first('sent_at');
const metaStatus=await env.DB.prepare('SELECT * FROM finance_meta_sync WHERE id=1').first();
const cards=[['Recognized revenue',f.revenue,'Delivered/fulfilled orders, after recorded refunds','revenue'],['Collected net sales',f.collected,'Payment captures and recorded collections','collected'],['Gross profit',f.grossProfit,'Before operating expenses; costs may be incomplete','grossProfit'],['Net profit estimate',f.profit,'Requires complete costs, fees and reconciled history','profit']];
---
<Admin title="Finance" user={user}>
 <link rel="stylesheet" href="/admin/finance.css"/>
 <script is:inline src="/admin/finance.js" defer></script>
 <div class="finance-root">
  <header class="fin-header"><div><p class="fin-eyebrow">UNLISTED / FINANCIAL OPERATING SYSTEM</p><h1>Your money. In focus.</h1><p>One workspace for cash, clothing drops and confident decisions.</p></div><a class="fin-button secondary" href={'/admin/finance-export.csv'+Astro.url.search}>Export report ↗</a></header>
  <nav class="fin-tabs" aria-label="Finance sections">{tabs.map(([key,label])=><a href={link(key)} aria-current={tab===key?'page':undefined}>{label}</a>)}</nav>
  {error&&<p role="alert" class="fin-error">{error}</p>}
  <form method="get" class="fin-range"><input type="hidden" name="tab" value={tab}/><label>From<input name="start" type="date" value={f.range.current.startDate} max={today}/></label><label>To<input name="end" type="date" value={f.range.current.endDate} max={today}/></label><label>Compare<select name="compare"><option value="previous" selected={f.range.comparison==='previous'}>Previous period</option><option value="year" selected={f.range.comparison==='year'}>Previous year</option><option value="none" selected={f.range.comparison==='none'}>No comparison</option></select></label><button>Apply</button><span>{dateRangeLabel(f.range.current)} · EGP · Cairo</span></form>
  {f.range.error&&<p class="fin-error">{f.range.error}</p>}
  {tab==='overview'&&<>
   <div class="fin-cards">{cards.map(([label,value,description,key])=><article class="fin-stat"><span>{label}</span><strong>{['grossProfit','profit'].includes(key)&&!f.profitReliable?'Incomplete':money(value)}</strong><small>{description}</small>{f.previous&&(!['grossProfit','profit'].includes(key)||f.profitReliable&&f.previous.profitReliable)&&<em>{metricChange(value,f.previous[key]).label} vs {f.range.previousLabel}</em>}</article>)}</div>
   <div class="fin-grid"><section class="fin-panel"><div class="fin-panel-heading"><h2>Revenue & costs</h2><span>Daily · EGP</span></div><svg class="fin-chart" viewBox="0 0 720 210" role="img" aria-label="Revenue in green and known costs in grey across the selected period"><line x1="10" x2="710" y1="180" y2="180" stroke="#ddd"/><g transform="translate(10,0)"><polyline points={points('expenses')} fill="none" stroke="#929b96" stroke-width="2"/><polyline points={points('revenue')} fill="none" stroke="#146a4b" stroke-width="3"/></g></svg><p class="fin-muted">Green: recognized revenue · Grey: COGS and recorded expenses. Missing costs remain excluded.</p></section>
    <section class="fin-panel"><div class="fin-panel-heading"><h2>Data confidence</h2><span>{f.dataScore}/100</span></div><meter min="0" max="100" value={f.dataScore}>{f.dataScore}%</meter><p>{f.profitReliable?'All currently tracked inputs are present.':'Profit remains provisional until missing costs and reconciliation issues are resolved.'}</p><p class="fin-muted">This score measures completeness, not creditworthiness or a guarantee of financial health.</p><ul>{f.recommendations.map(r=><li>{r}</li>)}</ul></section>
   </div>
   <div class="fin-cards compact">{[['Reported bank + cash',f.cashReported],['Estimated cash after manual entries',f.cashEstimated],['Recorded liabilities',f.liabilities],['Uncollected order value',f.uncollected],['Inventory value',f.inventoryValue],['Safe available spending',f.safeSpending]].map(([label,value])=><article class="fin-stat"><span>{label}</span><strong>{value===null?'Incomplete':money(value)}</strong></article>)}</div>
   <div class="fin-grid"><section class="fin-panel"><h2>Cash & commitments</h2><dl><div><dt>Remaining stock</dt><dd>{f.remainingStock} units</dd></div><div><dt>Cash runway</dt><dd>{f.runway===null?'Insufficient data':Math.floor(f.runway)+' days'}</dd></div><div><dt>Customer advances / refund liability</dt><dd>{money(f.customerLiability)}</dd></div><div><dt>Known borrowing</dt><dd>{money(Math.max(0,-(f.ledger.loans||0)))}</dd></div><div><dt>Supplier payables</dt><dd>{money(Math.max(0,-(f.ledger.supplier_payable||0)))}</dd></div><div><dt>Storewide collected revenue / ad spend</dt><dd>{f.roas===null?'—':f.roas.toFixed(2)+'×'}</dd></div></dl><p class="fin-muted">Collected sales can remain with Paymob or the courier. They are not added to your bank balance without settlement evidence. Spending estimates reserve recorded liabilities and {f.settings.runway_days} days of known operating costs.</p></section><section class="fin-panel"><h2>Actions that need you</h2>{!f.notifications.length?<p class="fin-muted">No active alerts.</p>:f.notifications.map(n=><article class="fin-alert"><strong>{n.title}</strong><p>{n.message}</p><FinanceForm op="dismiss" fields={[{name:'notification_id',type:'hidden',value:n.id}]} submit="Mark reviewed"/></article>)}</section></div>
   <section class="fin-panel"><h2>Ask your AI accountant</h2><form method="post" action="/admin/finance-action" class="fin-form"><input type="hidden" name="op" value="advice"/><label class="fin-full">Question<textarea name="question" maxlength="1500" required placeholder="Can COZY afford another production batch? What financial inputs are missing?"></textarea></label><button>Analyze recorded finances</button></form>{advice&&<article><h3>{advice.question}</h3><p class="fin-source">{advice.response}</p><p class="fin-muted">AI guidance for review. It does not post transactions or change budgets.</p></article>}</section>
   <details class="fin-panel"><summary>Accounting assumptions & missing evidence ({f.warnings.length})</summary><ul>{f.warnings.map(w=><li>{w}</li>)}</ul><p>{f.uncostedUnits} sold units lack original costs. Cash is based on reported snapshots, never inferred from profit. Imported Shopify duplicates can be linked in controls. Historical figures remain provisional until reconciled.</p></details>
  </>}
  {tab==='accountant'&&<div class="fin-stack">
   <section class="fin-panel"><h2>Tell your accountant what happened</h2><p class="fin-muted">Send English or Arabic notes, invoices, receipts or bank statements. Review the extracted details before anything enters the books.</p><form method="post" action="/admin/finance-action" enctype="multipart/form-data" class="fin-form" data-finance-upload><input type="hidden" name="op" value="extract"/><label class="fin-full">Describe the transaction<textarea name="text" maxlength="45000" rows="4" placeholder="I paid EGP 2,500 from the bank for COZY packaging…"></textarea></label><label class="fin-full">Attach a file (up to 8 MB)<input name="file" type="file" accept=".csv,.txt,.tsv,.pdf,.png,.jpg,.jpeg,.webp,.docx,.xlsx,.xls,.mp3,.wav,.m4a,.ogg,.webm"/></label><div class="fin-full fin-row"><button type="button" class="secondary" data-record-voice>Record voice note</button><span data-record-status role="status"></span></div><p class="fin-muted fin-full">{env.AI?'AI is connected.':'AI extraction requires activation. CSV import and manual transactions work without it.'} Original files stay private. CSV columns: date, amount, kind, category, account, note.</p><button>Extract for review</button></form></section>
   {selectedImport&&<section class="fin-panel"><h2>Review: {selectedImport.name}</h2><p>Status: {selectedImport.state}. Confirm dates, payment accounts and transaction types. Balance totals must not be imported as income.</p>{selectedImport.media_key&&<a href={'/admin/finance-file?id='+selectedImport.id}>Download original</a>}<details><summary>Extracted source</summary><pre class="fin-source">{extracted?.sourceText}</pre></details>{selectedImport.state==='review'&&<form method="post" action="/admin/finance-action" class="fin-stack"><input type="hidden" name="op" value="confirm_import"/><input type="hidden" name="tab" value="accountant"/><input type="hidden" name="import_id" value={selectedImport.id}/>{extracted.rows.map((r,n)=><fieldset class="fin-import-row"><legend>Transaction {n+1}</legend><label class="fin-check"><input type="checkbox" name={'include_'+n} checked/>Include this transaction</label>{r.warning&&<p class="fin-error">{r.warning}</p>}<div class="fin-form"><label>Date<input name={'date_'+n} type="date" value={r.date} max={today}/></label><label>Amount (EGP)<input name={'amount_'+n} type="number" min="0.01" step=".01" value={r.amount}/></label><label>Type<select name={'kind_'+n}><option value="">Choose type</option>{moneyKinds.map(([k,l])=><option value={k} selected={r.kind===k}>{l}</option>)}</select></label><label>Account<select name={'account_'+n}><option value="">Choose account</option>{accounts.map(([k,l])=><option value={k} selected={r.account===k}>{l}</option>)}</select></label><label>Transfer destination<select name={'to_account_'+n}><option value="bank">Bank</option><option value="cash">Cash</option></select></label><label>Category<input name={'category_'+n} value={r.category}/></label><label class="fin-full">Description<input name={'note_'+n} value={r.note} maxlength="500"/></label></div><label class="fin-check"><input type="checkbox" name={'duplicate_'+n}/>If flagged as a duplicate, I verified this is a separate transaction.</label></fieldset>)}<label class="fin-check"><input name="confirmed" type="checkbox" value="yes" required/>I checked the selected entries against the original source.</label><button>Confirm & save selected transactions</button></form>}</section>}
   <section class="fin-panel"><h2>Recent documents</h2><div class="fin-table"><table><thead><tr><th>Document</th><th>Status</th><th>Review</th></tr></thead><tbody>{f.imports.map(i=><tr><td>{i.name}</td><td>{i.state}</td><td><a href={link('accountant')+'&import='+i.id}>Open</a></td></tr>)}</tbody></table></div></section>
  </div>}
  {tab==='cash'&&<>
   <div class="fin-grid"><section class="fin-panel"><h2>Record a transaction</h2><FinanceForm tab={tab} op="transaction" fields={[select('kind','Type',moneyKinds),select('category','Category',expenseCategories.map(c=>[c,c])),amount(),date(),select('account','Payment account',accounts),select('to_account','Destination (transfers only)',accounts.slice(0,2)),select('drop_id','Drop',dropOptions),text('campaign_id','Campaign ID (optional)',false),{...text('note','Description / invoice reference'),full:true},text('duplicate_reason','Duplicate-review reason (only if flagged)',false)]} note="Owner withdrawals and loan repayments do not reduce profit. Supplier invoices create debt; supplier payments settle it. A manufacturing batch already creates its invoice when received."/></section>
   <section class="fin-panel"><h2>Bank & cash reconciliation</h2>{f.balances.map(b=><p><strong>{b.account==='bank'?'Bank':'Cash'}: {b.balance===null?'Not reported':money(b.balance)}</strong><small> · {b.reported_on||'No snapshot'}</small></p>)}<FinanceForm tab={tab} op="balance" fields={[select('account','Account',accounts.slice(0,2)),{...amount('balance','Actual balance (EGP)'),min:-1000000},date('reported_on'),text('note','Statement reference / reconciliation notes',false)]} submit="Confirm actual balance" note="A reported balance is an observation, not income. Transactions after the snapshot adjust the estimate; review differences against your bank statement."/></section></div>
   <section class="fin-panel"><h2>Journal · recent entries</h2><div class="fin-table"><table><thead><tr><th>Date</th><th>Type / category</th><th>Note</th><th>Balanced postings (EGP)</th><th>ID</th></tr></thead><tbody>{f.journals.map(j=><tr><td>{j.occurred_on}</td><td>{j.kind}<small>{j.category}</small></td><td>{j.note}</td><td>{JSON.parse(j.postings).map(p=><div>{p.account}: {money(p.amount)}</div>)}</td><td><code>{j.id}</code></td></tr>)}</tbody></table></div></section>
   <section class="fin-panel"><h2>Correct a journal</h2><FinanceForm tab={tab} op="reverse" fields={[text('journal_id','Original journal ID'),date(),text('note','Correction reason')]} submit="Post reversal" note="Original entries remain in the audit history. Stock-changing gifts and received batches need operational corrections."/></section>
  </>}
  {tab==='drops'&&<>
   <section class="fin-panel"><h2>Drop performance</h2><p class="fin-muted">Product revenue excludes customer shipping. Profit below is contribution before shared fees and overhead. Break-even uses entered fixed costs and current average unit contribution.</p><div class="fin-table"><table><thead><tr><th>Drop</th><th>Product revenue</th><th>COGS</th><th>Direct contribution</th><th>Stock</th><th>Break-even units</th><th>Potential sellout contribution</th></tr></thead><tbody>{f.dropReports.map(d=><tr><td>{d.name}</td><td>{money(d.revenue)}</td><td>{money(d.cogs)}</td><td>{money(d.profit)}</td><td>{d.remainingStock}</td><td>{d.breakEvenUnits??'Incomplete'}</td><td>{d.potentialProfit===null?'Incomplete':money(d.potentialProfit)}</td></tr>)}</tbody></table></div></section>
   <div class="fin-grid"><section class="fin-panel"><h2>Create a clothing drop</h2><FinanceForm tab={tab} op="drop" fields={[text('name','Drop name'),amount('fixed_cost','Fixed costs for planning (EGP)','0')]} note="Fixed costs here are a planning assumption. Record paid overhead separately in the ledger."/></section><section class="fin-panel"><h2>Assign a product to a drop</h2><FinanceForm tab={tab} op="assign_drop" fields={[select('product_id','Product',f.products.map(p=>[p.id,p.title])),select('drop_id','Drop',dropOptions.slice(1))]}/></section></div>
   <section class="fin-panel"><h2>Plan a manufacturing batch</h2><FinanceForm tab={tab} op="batch" fields={[text('name','Batch / supplier reference'),select('drop_id','Drop',dropOptions.slice(1)),select('variant_id','Product / size',variantOptions),{name:'quantity',label:'Units produced',type:'number',min:1,max:1000000},amount('raw_materials','Raw materials (EGP)','0'),amount('manufacturing','Manufacturing (EGP)','0'),amount('packaging','Packaging (EGP)','0'),amount('freight','Inbound shipping (EGP)','0'),amount('overhead','Allocated production overhead (EGP)','0')]} submit="Save planned batch"/></section>
   <section class="fin-panel"><h2>Production batches</h2>{f.batches.map(b=><article class="fin-import-row"><div class="fin-row"><strong>{b.name} · {b.product} / {b.variant}</strong><span>{b.quantity} units · {money(b.cost)} · {b.state}</span></div>{b.state==='planned'&&<FinanceForm tab={tab} op="receive_batch" fields={[{type:'hidden',name:'batch_id',value:b.id},date()]} submit="Receive batch & update stock" note="Adds physical stock, calculates weighted average cost, and records an unpaid supplier invoice. Pay it once through Supplier payment."/>}</article>)}</section>
  </>}
  {tab==='inventory'&&<>
   <section class="fin-panel"><h2>Stock & product margins</h2><div class="fin-table"><table><thead><tr><th>Product / variant</th><th>Stock</th><th>Selling price</th><th>Unit cost</th><th>Before-fee margin</th><th>Restock threshold</th></tr></thead><tbody>{f.variants.map(v=><tr><td>{v.product}<small>{v.title}</small></td><td>{v.inventory??'Unverified'}</td><td>{money(v.price)}</td><td>{v.unit_cost===null?'Missing':money(v.unit_cost)}</td><td>{v.unit_cost===null||v.price<=0?'—':((v.price-v.unit_cost)/v.price*100).toFixed(1)+'%'}</td><td>{v.threshold??'Not set'}</td></tr>)}</tbody></table></div></section>
   <section class="fin-panel"><h2>Product contribution · selected period</h2><div class="fin-table"><table><thead><tr><th>Product</th><th>Net product revenue</th><th>Known COGS</th><th>Contribution before unallocated fees</th></tr></thead><tbody>{f.productReports.map(p=><tr><td>{p.title}</td><td>{money(p.revenue)}</td><td>{money(p.cogs)}</td><td>{money(p.contribution)}</td></tr>)}</tbody></table></div></section>
   <div class="fin-grid"><section class="fin-panel"><h2>Current manufacturing cost</h2><FinanceForm tab={tab} op="unit_cost" fields={[select('variant_id','Product / size',variantOptions),amount('unit_cost','Landed unit cost (EGP)')]} note="Includes production, packaging and inbound freight. Applies to new sales from now. Historical costs require explicit confirmation."/></section><section class="fin-panel"><h2>Factory restock alert</h2><FinanceForm tab={tab} op="threshold" fields={[select('variant_id','Product / size',variantOptions),{name:'threshold',label:'Alert at or below',type:'number',min:0,max:1000000},{name:'target',label:'Restock target',type:'number',min:1,max:1000000}]} note="Uses existing stock movements automatically. Alerts trigger on threshold crossings; no daily stock counts."/></section></div>
   <section class="fin-panel"><h2>Free & paid influencer PR</h2><FinanceForm tab={tab} op="gift" fields={[select('variant_id','Gifted product / size',variantOptions),{name:'quantity',label:'Quantity',type:'number',min:1,max:100,value:1},date('gifted_on'),text('recipient','Influencer / recipient'),amount('influencer_fee','Collaboration fee (EGP)','0'),amount('shipping','Shipping cost (EGP)','0'),select('account','Fees paid from',accounts),text('campaign_id','Linked Meta campaign ID (optional)',false),text('note','Notes / collaboration reference',false)]} submit="Confirm PR gift & reduce stock" note="A free gift has zero collaboration fee. Product cost and shipping still count. Stock decreases exactly once."/></section>
   <section class="fin-panel"><h2>PR history</h2><div class="fin-table"><table><thead><tr><th>Date / influencer</th><th>Product</th><th>Qty</th><th>Product cost</th><th>Fee + shipping</th></tr></thead><tbody>{f.prGifts.map(g=><tr><td>{g.gifted_on}<small>{g.recipient}</small></td><td>{g.product} / {g.variant}</td><td>{g.quantity}</td><td>{money(g.quantity*g.cost_per_unit)}</td><td>{money(g.influencer_fee+(g.shipping||0))}</td></tr>)}</tbody></table></div></section>
  </>}
  {tab==='marketing'&&<>
   <section class="fin-panel"><div class="fin-panel-heading"><h2>Meta Ads Manager</h2><span>{metaReady(env)?'Configured':'Not connected'}</span></div><p>Spend comes from Meta’s official read-only API. Meta-attributed sales and your collected website sales are shown separately.</p><p class="fin-muted">{metaStatus?.last_success?'Last successful sync: '+new Date(metaStatus.last_success*1000).toLocaleString('en-GB',{timeZone:'Africa/Cairo'}):'No successful sync recorded.'} {metaStatus?.last_error}</p><FinanceForm op="sync_meta" tab={tab} fields={[]} submit="Sync last 30 days" note="Requires an EGP ad account using Cairo reporting time and a server-side token with ads_read. No campaign creation or budget changes."/></section>
   <section class="fin-panel"><h2>Campaign performance</h2><div class="fin-table"><table><thead><tr><th>Campaign</th><th>Spend</th><th>Meta revenue</th><th>Meta ROAS</th><th>Linked net collections</th><th>ROAS after linked fees</th><th>Meta CPA</th><th>Contribution estimate</th></tr></thead><tbody>{f.campaigns.map(c=><tr><td>{c.name}<small>{c.id}</small></td><td>{money(c.spend)}</td><td>{money(c.platformRevenue)}</td><td>{c.platformRoas?.toFixed(2)??'—'}</td><td>{money(c.collected)}</td><td>{c.roas?.toFixed(2)??'—'}</td><td>{c.cpa===null?'—':money(c.cpa)}</td><td>{money(c.profit)}</td></tr>)}</tbody></table></div><p class="fin-muted">Actual ROAS uses net collections less linked costs, for orders with verified campaign links. Campaign contribution excludes unallocated gateway/courier fees and missing costs. Meta attribution is not proof of collected cash.</p></section>
   <section class="fin-panel"><h2>Link a verified order to a campaign</h2><FinanceForm tab={tab} op="attribute" fields={[select('source','Order source',[['website','Website'],['shopify','Historical Shopify']]),text('order_id','Exact order ID'),text('campaign_id','Meta campaign ID')]} note="Use verified campaign/UTM evidence. Unlinked orders remain unallocated."/></section>
  </>}
  {tab==='planning'&&<>
   <section class="fin-panel"><h2>What happens if…</h2><p class="fin-muted">Planning assumptions only. Nothing changes prices, stock, ad budgets or your books.</p><form class="fin-form" data-scenario><label>Selling price (EGP)<input name="price" type="number" min="0" step=".01" required/></label><label>Landed unit cost (EGP)<input name="unitCost" type="number" min="0" step=".01" required/></label><label>Other variable cost per unit (EGP)<input name="variableCost" type="number" min="0" step=".01" value="0" required/></label><label>Fixed costs (EGP)<input name="fixedCost" type="number" min="0" step=".01" value="0" required/></label><label>Units sold / produced<input name="units" type="number" min="1" step="1" required/></label><label>Advertising budget (EGP)<input name="ads" type="number" min="0" step=".01" value="0" required/></label><label>Expansion investment (EGP)<input name="expansion" type="number" min="0" step=".01" value="0" required/></label><button>Calculate scenario</button></form><div class="fin-scenario" data-scenario-result role="status"></div></section>
   <section class="fin-panel"><h2>Forecast & recovered investment</h2><dl><div><dt>Next 30-day revenue at current daily pace</dt><dd>{money(Math.round(f.revenue/f.range.days*30))}</dd></div><div><dt>Next 30-day estimated profit at current pace</dt><dd>{f.profitReliable?money(Math.round(f.profit/f.range.days*30)):'Incomplete costs'}</dd></div><div><dt>Owner capital recorded</dt><dd>{money(Math.max(0,-(f.ledger.capital||0)))}</dd></div><div><dt>Owner withdrawals recorded</dt><dd>{money(f.ledger.drawings||0)}</dd></div><div><dt>Capital recovered as withdrawals</dt><dd>{-(f.ledger.capital||0)>0?(Math.min(1,(f.ledger.drawings||0)/-(f.ledger.capital||0))*100).toFixed(1)+'%':'Opening investment required'}</dd></div></dl><p class="fin-muted">A pace projection is not a demand forecast. It inherits missing costs, incomplete history and seasonal uncertainty. Withdrawals measure cash returned to the owner, not earned profit.</p></section>
  </>}
  {tab==='settings'&&<>
   <div class="fin-grid"><section class="fin-panel"><h2>Daily check-in · 9 PM Cairo</h2><form method="post" action="/admin/finance-action" class="fin-stack"><input name="op" type="hidden" value="settings"/><input name="tab" type="hidden" value="settings"/><input name="request_id" type="hidden" value={makeToken(16)}/><label class="fin-check"><input name="daily_reminder" type="checkbox" checked={f.settings.daily_reminder===1}/>Daily in-app bank/balance reminder</label><label class="fin-check"><input name="email_reminder" type="checkbox" checked={f.settings.email_reminder===1}/>Email reminders and triggered alerts</label><label>Protected cash reserve (EGP)<input name="reserve" type="number" min="0" step=".01" value={f.settings.reserve/100}/></label><label>Operating-cost buffer (days)<input name="runway_days" type="number" min="1" max="365" value={f.settings.runway_days}/></label><label class="fin-check"><input name="confirmed" type="checkbox" value="yes" required/>Confirm notification and reserve settings</label><button>Save controls</button></form><p class="fin-muted">Email: {emailReady(env)?'configured':'sender not configured'} · {emailSent?'A delivery was accepted by the email provider.':'No delivery has been verified yet.'} The ChatGPT reminder must remain until app delivery is verified.</p><FinanceForm op="test_reminder" tab={tab} fields={[]} submit="Send one notification test" note="Sends a delivery test to the configured owner email and in-app alerts. No financial transaction is recorded."/><button type="button" class="secondary" data-enable-notifications>Enable device notifications while app is open</button><p class="fin-muted" data-notification-status>Background web push requires a separately configured push service. Email works with the app closed.</p></section><section class="fin-panel"><h2>Prevent duplicated order history</h2><FinanceForm tab={tab} op="link_order" fields={[text('website_order_id','Website order ID'),text('shopify_source_id','Matching Shopify source ID')]} submit="Link matching records" note="Use only when both records represent the same real order. The historical duplicate will be excluded from financial totals; neither original is deleted."/></section></div>
   <section class="fin-panel"><h2>Historical cost evidence</h2><p class="fin-muted">{f.missingCosts.length} order items need original costs. Current product costs never overwrite historical ones.</p><FinanceForm tab={tab} op="historical_cost" fields={[select('source','Source',[['website','Website'],['shopify','Shopify history'],['exchange','Exchange replacement']]),text('order_id','Order ID'),text('variant_key','Variant ID / historical SKU'),amount('unit_cost','Original unit cost (EGP)')]} submit="Confirm historical cost"/><div class="fin-table"><table><thead><tr><th>Source / order</th><th>Product</th><th>Variant key</th><th>Units</th></tr></thead><tbody>{f.missingCosts.slice(0,60).map(m=><tr><td>{m.source}<small>{m.order_id}</small></td><td>{m.label}</td><td>{m.variant_key}</td><td>{m.quantity}</td></tr>)}</tbody></table></div></section>
   <section class="fin-panel"><h2>Audit trail</h2><div class="fin-table"><table><thead><tr><th>Time (Cairo)</th><th>Actor</th><th>Action</th><th>Record</th></tr></thead><tbody>{f.audit.map(a=><tr><td>{new Date(a.created_at*1000).toLocaleString('en-GB',{timeZone:'Africa/Cairo'})}</td><td>{a.actor}</td><td>{a.action}</td><td><code>{a.entity}</code></td></tr>)}</tbody></table></div></section>
  </>}
 </div>
</Admin>
