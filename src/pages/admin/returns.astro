---
import {env} from 'cloudflare:workers';
import Admin from '../../layouts/Admin.astro';
import Legacy from '../../components/admin/Returns.astro';
import {currentUser} from '../../lib/auth.js';
import {all} from '../../lib/db.js';
import {caseDetail,ensureRma,policy} from '../../lib/rma.js';
import {rmaConnections} from '../../lib/rma-providers.js';
import {rmaStates,reasons} from '../../lib/rma-math.js';
import {money,displayDate} from '../../lib/content.js';
const user=await currentUser(env,Astro,'admin');if(!user)return Astro.redirect('/admin/login',303);
await ensureRma(env.DB);const ar=Astro.url.searchParams.get('lang')==='ar',lang=ar?'ar':'en',t=(a,b)=>ar?b:a;
const c=await caseDetail(env.DB,Astro.url.searchParams.get('request')),p=await policy(env.DB),connections=rmaConnections(env);
const days=['7','30','90'].includes(Astro.url.searchParams.get('days'))?Number(Astro.url.searchParams.get('days')):30;
const state=Astro.url.searchParams.get('state')||'all',q=(Astro.url.searchParams.get('q')||'').slice(0,100),offset=Math.max(0,parseInt(Astro.url.searchParams.get('offset')||'0')||0);
const rows=c?[]:await all(env.DB.prepare(`SELECT *,(SELECT count(*) FROM rma_cases x WHERE x.source_key=rma_cases.source_key AND (x.created_at<rma_cases.created_at OR (x.created_at=rma_cases.created_at AND x.id<=rma_cases.id))) n FROM rma_cases WHERE (?='all' OR state=?) AND (?='' OR instr(lower(email||' '||order_reference||' '||id),lower(?))>0) ORDER BY created_at DESC LIMIT 51 OFFSET ?`).bind(state,state,q,q,offset));
const stats=await env.DB.prepare(`SELECT count(*) requests,coalesce(sum(state IN('requested','approved','received')),0) open,coalesce(sum(CASE WHEN kind='exchange' THEN item_value ELSE 0 END),0) retained,coalesce(sum(CASE WHEN state='completed' AND kind='refund' THEN -settlement ELSE 0 END),0) refunded FROM rma_cases WHERE created_at>=unixepoch()-?`).bind(days*86400).first();
const trends=await all(env.DB.prepare('SELECT reason,count(*) count FROM rma_cases WHERE created_at>=unixepoch()-? GROUP BY reason ORDER BY count DESC').bind(days*86400));
const costs=await env.DB.prepare('SELECT coalesce(sum(cost),0) amount FROM rma_shipments WHERE updated_at>=unixepoch()-?').bind(days*86400).first('amount');
const mail=await env.DB.prepare('SELECT count(*) count FROM rma_mail WHERE sent_at IS NULL').first('count');
const n=c?await env.DB.prepare('SELECT count(*) n FROM rma_cases x WHERE x.source_key=? AND (x.created_at<? OR (x.created_at=? AND x.id<=?))').bind(c.source_key,c.created_at,c.created_at,c.id).first('n'):0;
const rlabel=(ref,k)=>ref+'-R'+k;
const kinds={refund:t('Refund','استرداد'),exchange:t('Exchange','استبدال'),credit:t('Store credit','رصيد متجر')};
const elig={eligible:t('Within return window','ضمن مدة الاسترجاع'),delivery_review:t('Delivery date unknown — check before approving','تاريخ التسليم غير معروف'),outside_window:t('Outside return window','خارج مدة الاسترجاع'),evidence_review:t('Order amounts need checking','يلزم مراجعة المبالغ'),customer_review:t('Waiting for customer to confirm','بانتظار تأكيد العميل')};
const hints={requested:t('The customer asked for this. Approve or decline it.','العميل طلب ذلك. وافق أو ارفض.'),approved:t('Book the Bosta pickup below. When the item reaches you, check it and press “Item arrived”.','احجز استلام بوسطة بالأسفل. عند وصول المنتج افحصه واضغط "وصل المنتج".'),received:t('Send the refund (or the new size), then close the return.','أرسل المبلغ أو المقاس الجديد ثم أغلق الطلب.')};
const connected=['bosta','shipblu'].filter(k=>connections[k]);
const actions=c?({requested:[['approve',t('Approve','موافقة')],['decline',t('Decline','رفض')]],approved:[['receive',t('Item arrived','وصل المنتج')],['cancel',t('Cancel return','إلغاء الطلب')]],received:[['complete',t('Close return','إغلاق الطلب')]]}[c.state]||[]):[];
---
<Admin title="Returns & exchanges" user={user}>
{Astro.url.searchParams.has('return')||Astro.url.searchParams.has('legacy')?<Legacy/>:<div dir={ar?'rtl':'ltr'}>
 <div class="admin-heading"><div><p class="overline">UNLISTED · {t('CUSTOMER CARE','خدمة العملاء')}</p><h1>{t('Returns & exchanges','الاستبدال والاسترجاع')}</h1><p>{t('Requests, replacements, refunds and inventory in one place.','الطلبات والبدائل والمبالغ المستردة والمخزون في مكان واحد.')}</p></div><a class="button" href={'/admin/returns?lang='+(ar?'en':'ar')+(c?'&request='+c.id:'')}>{ar?'English':'العربية'}</a></div>
 {c?<>
  <p><a href={'/admin/returns?lang='+lang}>← {t('All requests','كل الطلبات')}</a> · <a href={'/admin/orders?order='+encodeURIComponent(c.source_key.startsWith('website:')?c.source_key.slice(8):'history:'+c.source_key.slice(8))}>{c.order_reference}</a></p>
  <section class="panel"><div class="rma-heading"><h2>{t('Return','مرتجع')} {rlabel(c.order_reference,n)}</h2><span class="pill">{rmaStates[c.state][ar?1:0]}</span></div>
   <dl class="admin-kv"><div><dt>{t('Customer','العميل')}</dt><dd>{c.order.name} · {c.email} · {c.order.phone}</dd></div><div><dt>{t('Pickup address','عنوان الاستلام')}</dt><dd>{c.order.address} · {c.order.city}</dd></div><div><dt>{t('Resolution','الطلب')}</dt><dd>{kinds[c.kind]} · {reasons[c.reason]?.[ar?1:0]}</dd></div><div><dt>{t('Return window','مدة الاسترجاع')}</dt><dd>{elig[c.eligibility]||c.eligibility}</dd></div><div><dt>{t('Original payment','الدفع الأصلي')}</dt><dd>{c.order.method} · {c.payment_verified?t('Paid','مدفوع'):t('Not confirmed yet','غير مؤكد')}</dd></div><div><dt>{t('Return value / replacement value','قيمة المرتجع / البديل')}</dt><dd>{money(c.item_value,true)} / {money(c.replacement_value,true)}</dd></div><div><dt>{t('Fee / delivery refund','الرسوم / استرداد الشحن')}</dt><dd>{money(c.fee,true)} / {money(c.shipping_refund,true)}</dd></div><div><dt>{c.settlement>0?t('Collect price difference','تحصيل فرق السعر'):t('Refund / credit due','المبلغ المستحق للعميل')}</dt><dd><strong>{money(Math.abs(c.settlement),true)}</strong></dd></div></dl>
   <p class="preserve">{c.reason_note}</p><div class="table-wrap"><table><thead><tr><th>{t('Item','المنتج')}</th><th>{t('Qty','الكمية')}</th><th>{t('Replacement','البديل')}</th><th>{t('Restocked','أُعيد للمخزون')}</th></tr></thead><tbody>{c.lines.map(l=><tr><td>{l.title}<small>{l.variant_id||t('Inventory match needs review','يلزم مطابقة المخزون')}</small></td><td>{l.quantity}</td><td>{l.replacement_title||'—'}</td><td>{l.restocked?'✓':'—'}</td></tr>)}</tbody></table></div>
   <div class="rma-photos">{c.photos.map(photo=><a href={'/admin/returns-photo?id='+photo.id} target="_blank" rel="noopener"><img src={'/admin/returns-photo?id='+photo.id} alt={t('Customer evidence','صورة من العميل')} width="140" height="140"/></a>)}</div>
   {c.replacement&&<p>{t('Linked replacement order','طلب الاستبدال المرتبط')}: <strong>{c.replacement.id.slice(0,16)}</strong> · {c.replacement.state}</p>}
   {c.credit&&<p>{t('Issued store credit','رصيد المتجر الصادر')}: {c.credit.code} · {t('Remaining','المتبقي')} {money(c.credit.balance,true)}</p>}
  </section>
  {c.state==='requested'&&['evidence_review','delivery_review','outside_window','customer_review'].includes(c.eligibility)&&<details class="panel"><summary>{t('Verify original order evidence','تأكيد بيانات الطلب الأصلي')}</summary><p>{t('Use invoices, courier delivery records and payment evidence. Updated amounts require customer confirmation before approval.','استخدم الفاتورة ودليل التسليم والتحصيل. يلزم تأكيد العميل للمبالغ المحدّثة قبل الموافقة.')}</p><form class="admin-form" action="/admin/returns-action" method="post"><input type="hidden" name="operation" value="verify-evidence"/><input type="hidden" name="id" value={c.id}/><input type="hidden" name="version" value={c.version}/>{c.source_key.startsWith('shopify:')&&<><label>{t('Verified original total (EGP)','إجمالي الطلب الأصلي المؤكد بالجنيه')}<input name="verified_total" required value={c.order.total==null?'':(c.order.total/100).toFixed(2)}/></label><label>{t('Prior refunds (EGP)','استردادات سابقة بالجنيه')}<input name="prior_refunded" required value={((c.order.refunded||0)/100).toFixed(2)}/></label></>}<label>{t('Verified delivery date','تاريخ التسليم المؤكد')}<input name="delivered_on" type="date" required/></label><label>{t('Original delivery amount to refund (EGP)','قيمة الشحن الأصلي المستردة بالجنيه')}<input name="shipping_refund" required value={(c.shipping_refund/100).toFixed(2)}/></label>{c.lines.map(l=><fieldset><legend>{l.quantity} × {l.title}</legend>{c.source_key.startsWith('shopify:')&&<label>{t('Verified value for these selected units (EGP)','القيمة المؤكدة للوحدات المختارة بالجنيه')}<input name={'value:'+l.line_key} required value={(l.value/100).toFixed(2)}/></label>}{!l.variant_id&&<label>{t('Exact inventory variant ID (optional; needed to restock)','معرف متغير المخزون المطابق (اختياري، مطلوب لإعادة المخزون)')}<input name={'variant:'+l.line_key} maxlength="100"/></label>}{l.unit_cost==null&&<label>{t('Original sold unit cost if evidenced (EGP, optional)','تكلفة الوحدة الأصلية بدليل (اختياري)')}<input name={'cost:'+l.line_key}/></label>}</fieldset>)}<label class="check"><input type="checkbox" name="payment_verified" checked={!!c.payment_verified}/>{t('Original payment collection verified','تأكد تحصيل مبلغ الطلب الأصلي')}</label><label>{t('Invoice / courier / payment evidence references','مراجع أدلة الفاتورة والتسليم والتحصيل')}<textarea name="message" required maxlength="800"/></label><button class="button">{t('Save evidence & ask customer to confirm','حفظ البيانات وطلب تأكيد العميل')}</button></form></details>}
  {actions.length>0&&<section class="panel"><h2>{t('What to do now','المطلوب الآن')}</h2><p class="muted">{hints[c.state]}</p><div class="action-grid">{actions.map(([action,label])=><form class="admin-form" action="/admin/returns-action" method="post"><input type="hidden" name="id" value={c.id}/><input type="hidden" name="version" value={c.version}/><input type="hidden" name="operation" value={action}/><input type="hidden" name="language" value={lang}/>
   {action==='approve'&&c.eligibility!=='eligible'&&<label class="check"><input name="reviewed" type="checkbox" required/>{t('I checked the order was delivered and this return is OK.','تأكدت من التسليم وأن الاسترجاع مقبول.')}</label>}
   {action==='receive'&&<>{c.lines.map(l=><label class="check"><input name={'restock:'+l.line_key} type="checkbox" disabled={!l.variant_id}/>{t('Put back in stock','إعادة للمخزون')}: {l.title}</label>)}{!c.payment_verified&&<><label class="check"><input name="payment_verified" type="checkbox"/>{t('Original payment was collected','تم تحصيل الدفع الأصلي')}</label><label>{t('Payment evidence / courier remittance reference','دليل التحصيل / مرجع تحويل شركة الشحن')}<input name="payment_evidence" maxlength="180"/></label></>}</>}
   {action==='complete'&&<>{c.kind==='credit'?<p>{t('Issues personal credit once. No cash refund is sent.','يصدر رصيدًا شخصيًا مرة واحدة دون تحويل نقدي.')}</p>:<><label>{t('How you refunded (e.g. InstaPay, Bosta tracking no.)','طريقة الاسترداد (مثل إنستاباي)')}<input name="reference" required maxlength="180"/></label>{c.settlement!==0&&<label class="check"><input type="checkbox" name="settlement_verified" required/>{t('I sent the exact amount shown above.','أرسلت المبلغ المعروض بالكامل.')}</label>}</>}</>}
   <label>{['approve','decline','cancel'].includes(action)?t('Message to customer','رسالة للعميل'):t('Note (optional)','ملاحظة (اختياري)')}<textarea name="message" maxlength="800" required={['approve','decline','cancel'].includes(action)}>{action==='approve'?(c.language==='ar'?p.instructions_ar:p.instructions_en):''}</textarea></label><button class="button">{label}</button>
  </form>)}</div></section>}
  {c.state==='received'&&c.kind!=='credit'&&c.settlement<0&&<section class="panel"><h2>Paymob</h2><p>{t('Refund to the verified original capture. Uncertain outcomes are held for reconciliation.','استرداد إلى عملية الدفع الأصلية المؤكدة. تُوقف النتائج غير المؤكدة للمراجعة.')}</p><form method="post" action="/admin/returns-action"><input name="id" value={c.id} type="hidden"/><input name="operation" value="paymob" type="hidden"/><button class="button" disabled={!connections.paymob||c.operations.some(o=>o.kind==='refund')}>{t('Issue exact Paymob refund','تنفيذ الاسترداد المحدد عبر Paymob')}</button></form></section>}
  {c.state==='received'&&c.kind==='exchange'&&c.settlement!==0&&<section class="panel"><h2>{t('Exchange price difference','فرق سعر الاستبدال')}</h2><form class="admin-form" action="/admin/returns-action" method="post"><input type="hidden" name="id" value={c.id}/><input type="hidden" name="operation" value="difference"/><label>{t('Payment / refund reference','مرجع الدفع أو الاسترداد')}<input name="reference" required maxlength="180"/></label><label>{t('Note','ملاحظة')}<input name="message" required maxlength="800"/></label><label class="check"><input name="settlement_verified" type="checkbox" required/>{t('Exact price difference settled','تمت تسوية فرق السعر المحدد')}</label><button class="button">{t('Record settlement','تسجيل التسوية')}</button></form></section>}
  {['approved','received','completed'].includes(c.state)&&<section class="panel"><h2>{t('Courier pickup','استلام شركة الشحن')}</h2>
   {c.shipments.map(s=><p><strong>{s.provider==='bosta'?'Bosta':s.provider}</strong> · {s.direction==='return'?t('Pickup from customer','استلام من العميل'):t('New size to customer','المقاس الجديد للعميل')} · {t('Tracking','رقم التتبع')} <strong>{s.tracking}</strong> · {s.status}{s.cost>0&&<> · {t('Bosta charged you','تكلفة بوسطة')} {money(s.cost,true)}</>}</p>)}
   {(c.state==='approved'&&!c.shipments.some(s=>s.direction==='return')||c.kind==='exchange'&&c.state==='received'&&!c.shipments.some(s=>s.direction==='replacement'))&&<form class="admin-form" method="post" action="/admin/returns-action"><input name="operation" value="booking" type="hidden"/><input name="id" value={c.id} type="hidden"/>
    {c.state==='approved'?<input name="direction" value="return" type="hidden"/>:<input name="direction" value="replacement" type="hidden"/>}
    <p>{c.state==='approved'?t('The courier collects the item from the customer and brings it back to you. Customer pays nothing; the courier charges your account.','شركة الشحن تستلم المنتج من العميل وتعيده لك. العميل لا يدفع شيئًا.'):t('The courier delivers the new size to the customer.','شركة الشحن توصل المقاس الجديد للعميل.')}</p>
    {connected.length>1?<label>{t('Courier','شركة الشحن')}<select name="provider">{connected.map(k=><option value={k}>{k==='bosta'?'Bosta':'ShipBlu'}</option>)}</select></label>:<input name="provider" value={connected[0]||'bosta'} type="hidden"/>}
    {connections.shipblu&&<label>{t('ShipBlu zone number (ShipBlu only)','رقم منطقة ShipBlu')}<input name="zone" maxlength="100"/></label>}
    <button class="button primary" disabled={!connected.length}>{c.state==='approved'?t('Book Bosta pickup','احجز استلام بوسطة'):t('Send new size with Bosta','أرسل المقاس الجديد مع بوسطة')}</button>{!connected.length&&<small>{t('Bosta is not connected. See Automations.','بوسطة غير متصلة.')}</small>}</form>}
   <details><summary>{t('Booked it yourself in Bosta’s dashboard? Add the tracking number','حجزت من لوحة بوسطة؟ أضف رقم التتبع')}</summary><form class="admin-form" method="post" action="/admin/returns-action"><input name="operation" value="tracking" type="hidden"/><input name="id" value={c.id} type="hidden"/>
    {c.kind==='exchange'?<label>{t('Shipment','الشحنة')}<select name="direction"><option value="return">{t('Pickup from customer','استلام من العميل')}</option><option value="replacement">{t('New size to customer','المقاس الجديد للعميل')}</option></select></label>:<input name="direction" value="return" type="hidden"/>}
    <label>{t('Courier','شركة الشحن')}<select name="provider"><option value="bosta">Bosta</option><option value="shipblu">ShipBlu</option><option value="aramex">Aramex</option><option value="manual">{t('Other','أخرى')}</option></select></label>
    <label>{t('Tracking number','رقم التتبع')}<input name="reference" maxlength="180" required/></label>
    <label>{t('Where is it now?','أين الشحنة الآن؟')}<select name="status"><option>{t('Booked','تم الحجز')}</option><option>{t('Picked up','تم الاستلام')}</option><option>{t('Delivered','تم التسليم')}</option></select></label>
    <label>{t('What the courier charged you (EGP)','تكلفة الشحن عليك (جنيه)')}<input name="cost" inputmode="decimal" value="0" required/></label>
    <label>{t('Note (optional)','ملاحظة (اختياري)')}<input name="message" maxlength="800"/></label>
    {c.kind==='exchange'&&<label class="check"><input name="delivered" type="checkbox"/>{t('New size delivered to customer','تم تسليم المقاس الجديد')}</label>}
    <button class="button">{t('Save tracking number','حفظ رقم التتبع')}</button></form></details>
  </section>}
  {c.operations.filter(o=>o.state!=='succeeded').map(o=><section class="panel"><h2>{t('Check this in the courier/Paymob dashboard','راجع لوحة الشركة')} · {o.provider}</h2><p>{o.kind} · {o.state} · {o.detail}</p><form class="admin-form" method="post" action="/admin/returns-action"><input name="operation" value="reconcile" type="hidden"/><input name="operation_id" value={o.id} type="hidden"/><input name="id" value={c.id} type="hidden"/><label>{t('Tracking / reference number you see there','رقم التتبع أو المرجع')}<input name="reference" required maxlength="180"/></label><label>{t('Note','ملاحظة')}<input name="message" required maxlength="800"/></label><label class="check"><input name="settlement_verified" type="checkbox" required/>{t('I can see it was created there.','تأكدت من وجودها هناك.')}</label><button class="button">{t('Save','حفظ')}</button></form></section>)}
  <section class="panel"><h2>{t('History','السجل')}</h2><ol>{c.events.map(e=><li><strong>{e.action}</strong> · {displayDate(e.created_at)} · {e.actor}<p class="preserve">{e.detail}</p></li>)}</ol></section>
 </>:<>
  <div class="rma-metrics">{[[t('Requests','الطلبات'),stats.requests],[t('Open','مفتوحة'),stats.open],[t('Refunded','المبالغ المستردة'),money(stats.refunded,true)],[t('Courier costs','تكاليف الشحن'),money(costs,true)]].map(([label,value])=><section class="panel"><small>{label}</small><strong>{value}</strong></section>)}</div>
  <section class="panel"><form class="rma-filters"><input type="hidden" name="lang" value={lang}/><label>{t('Search','بحث')}<input name="q" value={q} placeholder={t('Order, customer or request','طلب أو عميل')}/></label><label>{t('Status','الحالة')}<select name="state"><option value="all">{t('All','الكل')}</option>{Object.entries(rmaStates).map(([k,v])=><option value={k} selected={state===k}>{v[ar?1:0]}</option>)}</select></label><label>{t('Analytics period','فترة التحليل')}<select name="days">{[7,30,90].map(d=><option value={d} selected={days===d}>{d} {t('days','يوم')}</option>)}</select></label><button class="button">{t('Apply','تطبيق')}</button></form>
   <div class="table-wrap"><table><thead><tr><th>{t('Return','المرتجع')}</th><th>{t('Customer','العميل')}</th><th>{t('Type','النوع')}</th><th>{t('Status','الحالة')}</th><th>{t('Amount','المبلغ')}</th></tr></thead><tbody>{rows.slice(0,50).map(r=><tr><td><a href={'/admin/returns?request='+r.id+'&lang='+lang}>{rlabel(r.order_reference,r.n)}</a><small>{displayDate(r.created_at)}</small></td><td>{r.email}</td><td>{kinds[r.kind]}</td><td><span class="pill">{rmaStates[r.state][ar?1:0]}</span></td><td>{money(Math.abs(r.settlement),true)}</td></tr>)}</tbody></table></div>{!rows.length&&<p>{t('No matching requests.','لا توجد طلبات مطابقة.')}</p>}{rows.length>50&&<a href={'/admin/returns?offset='+(offset+50)+'&lang='+lang}>{t('Next','التالي')}</a>}
  </section>
  <div class="action-grid"><section class="panel"><h2>{t('Return reasons','أسباب الاسترجاع')}</h2>{trends.length?trends.map(r=><p>{reasons[r.reason]?.[ar?1:0]||r.reason} <strong>{r.count}</strong></p>):<p>{t('No requests in this period.','لا توجد طلبات خلال الفترة.')}</p>}</section><section class="panel"><h2>{t('Automations','الأتمتة')}</h2><p><a href="/admin/automations">{t('See Bosta, Paymob and alert status','حالة بوسطة وباي موب والتنبيهات')}</a></p></section></div>
  <details class="panel"><summary>{t('Policies & automation settings','السياسات وإعدادات الأتمتة')}</summary><form class="admin-form" method="post" action="/admin/returns-action"><input name="operation" value="policy" type="hidden"/><div class="action-grid"><label>{t('Standard window (minimum 14 days)','المدة العادية (١٤ يومًا على الأقل)')}<input name="days" type="number" min="14" max="365" value={p.days} required/></label><label>{t('Defect window (minimum 30 days)','مدة العيوب (٣٠ يومًا على الأقل)')}<input name="defect_days" type="number" min="30" max="365" value={p.defect_days} required/></label><label>{t('Extended goodwill fee (EGP; statutory cases always free)','رسوم السياسة الإضافية بالجنيه؛ الحقوق القانونية مجانية')}<input name="goodwill_fee" value={(p.goodwill_fee/100).toFixed(2)} required/></label><label>{t('Preferred courier','شركة الشحن المفضلة')}<select name="courier">{['manual','bosta','shipblu','aramex'].map(k=><option value={k} selected={p.courier===k}>{k}</option>)}</select></label></div><label class="check"><input name="auto_approve" type="checkbox" checked={!!p.auto_approve}/>{t('Automatically approve verified eligible paid orders','موافقة تلقائية للطلبات المدفوعة المؤكدة والمستوفية للشروط')}</label><label>English instructions<textarea name="instructions_en" required maxlength="800">{p.instructions_en}</textarea></label><label dir="rtl">تعليمات عربية<textarea name="instructions_ar" required maxlength="800">{p.instructions_ar}</textarea></label><button class="button">{t('Save policy','حفظ السياسة')}</button></form></details>
  <p><a href="/admin/returns?legacy=1">{t('Earlier return requests','طلبات الاسترجاع السابقة')}</a> · <a href="/admin/finance">{t('Finance dashboard','لوحة المالية')}</a> · <a href="/returns">{t('Customer portal','صفحة العميل')}</a></p>
 </>}
</div>}
</Admin>
