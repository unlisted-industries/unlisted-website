---
import { env } from 'cloudflare:workers';
import Admin from '../../layouts/Admin.astro';
import Notice from '../../components/Notice.astro';
import { adminEmails, currentUser } from '../../lib/auth.js';
import { passwordsReady } from '../../lib/admin-password.js';
if (await currentUser(env, Astro, 'admin')) return Astro.redirect('/admin', 303);
const ready = passwordsReady(env, Astro.url);
const askEmail = adminEmails(env).length > 1;
---
<Admin title="Owner sign-in">
  <div class="panel">
    <p class="overline">STORE MANAGEMENT</p>
    <h1>Owner sign-in</h1>
    <Notice success={Astro.url.searchParams.has('password-set') ? 'Password saved. Sign in with your new password.' : null} />
    {ready ? <>
      <form method="post" action="/admin/session" class="form">
        <input type="hidden" name="action" value="password" />
        {askEmail && <label>Email address <input name="email" type="email" autocomplete="username" maxlength="254" required /></label>}
        <label>Password <input name="password" type="password" autocomplete="current-password" maxlength="256" required /></label>
        <button class="btn" type="submit">SIGN IN</button>
      </form>
      <p class="muted">Use your private owner link to set your password the first time.</p>
    </> : <p>Owner sign-in is unavailable on this address.</p>}
  </div>
</Admin>
