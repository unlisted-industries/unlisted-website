---
import {env} from 'cloudflare:workers';
import Admin from '../../layouts/Admin.astro';
import CpaPlanner from '../../components/admin/CpaPlanner.astro';
import {currentUser} from '../../lib/auth.js';
import {operationsReport,operationAction} from '../../lib/operations.js';
import {formData,formError} from '../../lib/http.js';
import {makeToken} from '../../lib/db.js';
import {money,mediaUrl} from '../../lib/content.js';
const user=await currentUser(env,Astro,'admin');if(!user)return Astro.redirect('/admin/login',303);
if(Astro.request.method==='POST'){try{await operationAction(env.DB,await formData(Astro.request,300000),user.email);return Astro.redirect('/admin/operations?saved=1',303);}catch(e){return formError(e,'/admin/operations');}}
const r=await operationsReport(env.DB),project=r.projects.find(p=>p.id===Astro.url.searchParams.get('project'));
const q=(Astro.url.searchParams.get('q')||'').trim().slice(0,100).toLowerCase();
const unknown=n=>n===null?'Not confirmed':n;
---
<Admin title="Stocks & businesses" user={user}>
<link rel="stylesheet" href="/admin/finance.css"/>
<div class="finance-root simple-finance">
<header class="fin-header"><div><p class="fin-eyebrow">UNLISTED / OPERATIONS</p><h1>{project?project.name:'My stocks & businesses'}</h1><p>Paid costs, production, sales and pieces — with estimates kept separate.</p></div><a class="fin-button secondary" href="/admin/finance">Finance</a></header>
{Astro.url.searchParams.get('error')&&<p class="fin-error" role="alert">{Astro.url.searchParams.get('error')}</p>}
{project?<><p><a href="/admin/operations">← All stocks & businesses</a> · {project.business} · {project.state}</p><p>{project.note}</p>
<div class="fin-cards compact">{[['Paid costs reported',project.paid],['Known unpaid bills',project.unpaid],['Estimates · not payments',project.estimated],['Payment status unknown',project.unconfirmed]].map(([k,v])=><article class="fin-stat"><span>{k}</span><strong>{money(v)}</strong></article>)}</div>
<section class="fin-panel"><h2>Production & pieces</h2><div class="fin-table"><table><thead><tr><th>Product</th><th>Planned</th><th>Received</th><th>Personal</th><th>Samples taken</th><th>Price</th></tr></thead><tbody>{project.products.map(p=><tr><td>{p.name}<small>{p.note}</small></td><td>{unknown(p.planned)}</td><td>{unknown(p.received)}</td><td>{p.personal}</td><td>{p.samples}</td><td>{p.price===null?'Not final':money(p.price)}</td></tr>)}</tbody></table></div><p class="fin-muted">These are batch facts, not extra sellable stock. Only size-level confirmed receipts may increase website stock. Samples and personal pieces are not sales.</p></section>
<section class="fin-panel"><h2>Before customer sales · planning only</h2><p>Full-price revenue from initially received saleable pieces: <strong>{project.products.every(p=>p.received!==null&&p.price!==null)?money(project.products.reduce((n,p)=>n+Math.max(0,p.received-p.personal-p.samples)*p.price,0)):'Quantity or price is not final'}</strong>.</p><p class="fin-muted">This is not remaining inventory or earned profit. It excludes later sales, discounts, returns, fees, advertising and additional costs. Production estimates remain separate from payments.</p></section><section class="fin-panel"><h2>Actual results</h2><p>{project.lines.filter(l=>l.fulfilled).reduce((s,l)=>s+l.quantity,0)} ordered units on matched fulfilled/delivered lines. Refunds, exchanges and collection status still need line-level reconciliation.</p><p>Actual net sales, COGS, gross profit, net profit, inventory value and sellout profit: <strong>Incomplete until all order lines, original costs, fees and returned-stock evidence are matched.</strong></p><p>Bank/cash balance: use your bank update in Finance. Project payments without account/date evidence do not reduce a guessed bank balance.</p></section>
<section class="fin-panel"><h2>Costs & bills</h2><div class="fin-table"><table><thead><tr><th>Cost</th><th>EGP</th><th>Status</th><th>Evidence / note</th></tr></thead><tbody>{project.costs.map(c=><tr><td>{c.description}</td><td>{money(c.amount)}</td><td>{c.state}</td><td>{c.note}{c.journal_id&&' · Matched to recorded payment'}</td></tr>)}</tbody></table></div><p class="fin-muted">Reported historic payments are cost evidence, not new bank transactions. Match statement payments to these records rather than entering the cost again.</p></section></>:<>
<div class="fin-grid">{r.projects.map(p=><section class="fin-panel"><p class="fin-eyebrow">{p.business}</p><h2><a href={'/admin/operations?project='+encodeURIComponent(p.id)}>{p.name}</a></h2><p>{p.state}</p><dl><div><dt>Paid</dt><dd>{money(p.paid)}</dd></div><div><dt>Unpaid</dt><dd>{money(p.unpaid)}</dd></div><div><dt>Estimated extra costs</dt><dd>{money(p.estimated)}</dd></div></dl></section>)}</div>
{!r.projects.length&&<section class="fin-panel"><h2>Your projects are not loaded yet</h2><p>Import reviewed private project facts below. Nothing is assumed from product names or old order dates.</p></section>}
</>}
<CpaPlanner/>
<section class="fin-panel" id="stock"><h2>Stock management</h2><form method="get" class="fin-form"><label>Find a product or size<input name="q" value={q}/></label><button>Search</button></form><p class="fin-muted">Website available pieces already reflect its existing reservations and stock deductions. Do not subtract historical sales again. Unknown opening counts, receipts and personal size allocations remain unverified. Fulfilled includes historical Shopify shipments; it does not prove courier delivery. Counters are recorded evidence and must not be subtracted from available stock again.</p><div class="fin-table"><table><thead><tr><th>Product / size</th><th>Website available</th><th>Source available</th><th>Fulfilled / delivered</th><th>Reserved</th><th>Restocked</th><th>Exchanges out</th><th>Gifts / personal</th><th>Restock at</th><th>Opening / received by size</th><th>History / adjustment</th></tr></thead><tbody>{r.variants.filter(v=>(v.product+' '+v.title+' '+v.sku).toLowerCase().includes(q)).map(v=><tr><td>{v.image&&<img src={mediaUrl(v.image)} alt="" width="48" height="60" loading="lazy"/>}<strong>{v.product}</strong><small>{v.title} · {v.sku||'No SKU'}</small></td><td>{v.inventory??'Unverified'}{v.inventory!==null&&v.threshold!==null&&v.inventory<=v.threshold&&<small>Low stock</small>}</td><td>{v.source_available??'No snapshot'}{v.source_available!==null&&v.source_available!==v.inventory&&<small>Discrepancy — review</small>}</td><td>{v.fulfilled}</td><td>{v.reserved}</td><td>{v.returned}</td><td>{v.exchange}</td><td>{v.gifts} / {v.personal}<small>Recorded by size only</small></td><td>{v.threshold??'Not set'}</td><td>Needs batch-size evidence</td><td><details><summary>Adjust for a reason</summary><form method="post" class="fin-stack"><input type="hidden" name="op" value="stock_adjust"/><input type="hidden" name="request_id" value={makeToken(16)}/><input type="hidden" name="variant_id" value={v.id}/><input type="hidden" name="before" value={v.inventory}/><label>Reason<select name="reason"><option value="received">Received from factory</option><option value="personal">Personal withdrawal</option><option value="gift">Gift</option><option value="damaged">Damaged</option><option value="found">Count correction · found</option><option value="lost">Count correction · missing</option></select></label><label>Pieces<input name="quantity" type="number" min="1" step="1" required/></label><label>Evidence / reason<textarea name="note" required maxlength="500"/></label><label><input type="checkbox" name="confirmed" value="yes" required/>These pieces have not already been adjusted.</label><button disabled={v.inventory===null}>Save stock movement</button></form></details></td></tr>)}</tbody></table></div><p><a href="/admin/finance?tab=inventory">Set low-stock alerts / review existing PR gifts</a></p></section>
<details class="fin-panel"><summary>Stock movement history</summary>{r.movements.length?r.movements.map(m=><p>{m.reason} · {m.quantity} pieces · {m.before_qty} → {m.after_qty} · {m.note}</p>):<p>No new reason-based adjustments recorded. Earlier checkout and returns remain in their original records.</p>}</details>
<details class="fin-panel"><summary>Match sales to the correct stock</summary><p>Never assume every COZY order belongs to the same batch. Matching records does not deduct physical stock again.</p>{r.unallocated.slice(0,100).map(l=><details class="fin-alert"><summary>{l.reference} · {l.name} · {l.quantity} pieces · {l.paid?'payment recorded':'unpaid'}</summary><form method="post" class="fin-form"><input type="hidden" name="op" value="allocate"/><input type="hidden" name="request_id" value={makeToken(16)}/><input type="hidden" name="source" value={l.source}/><input type="hidden" name="order_id" value={l.order}/><input type="hidden" name="line_key" value={l.key}/><label>Stock / business<select name="project_id" required>{r.projects.map(p=><option value={p.id}>{p.business} / {p.name}</option>)}</select></label><label>Original cost per piece · optional<input name="unit_cost" type="number" min="0" step=".01"/></label><label>Why this batch?<input name="note" required maxlength="500"/></label><label><input type="checkbox" name="confirmed" value="yes" required/>I verified this assignment.</label><button>Match order</button></form></details>)}</details>
<details class="fin-panel"><summary>Import reviewed private stock/business facts</summary><p>Paste the private project JSON prepared from your confirmed inputs. Import does not add factory stock, create bank payments or overwrite existing records.</p><form method="post" class="fin-form"><input type="hidden" name="op" value="project_import"/><label class="fin-full">Private project data<textarea name="bundle" maxlength="250000" required rows="7"/></label><label><input type="checkbox" name="confirmed" value="yes" required/>I approve these facts and their payment states.</label><button>Save reviewed projects</button></form></details>
</div></Admin>
