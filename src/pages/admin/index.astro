---
import { env } from 'cloudflare:workers';
import Admin from '../../layouts/Admin.astro';
import StoreOverview from '../../components/admin/StoreOverview.astro';
import { passwordRecord, passwordsReady } from '../../lib/admin-password.js';
import { currentUser } from '../../lib/auth.js';

const user = await currentUser(env, Astro, 'admin');
if (!user) return Astro.redirect('/admin/login', 303);
const password = passwordsReady(env, Astro.url);
if (password && !await passwordRecord(env.DB, user.email)) return Astro.redirect('/admin/password', 303);
---
<Admin title="Overview" user={user}>
  <StoreOverview view="overview" password={password} />
</Admin>
