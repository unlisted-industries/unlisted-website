---
import { env } from 'cloudflare:workers';
import Store from '../../layouts/Store.astro';
import Notice from '../../components/Notice.astro';
import { lookupPage } from '../../lib/catalog.js';
import { safeHtml } from '../../lib/content.js';
const page = await lookupPage(env.DB, Astro.params.handle);
if (!page) Astro.response.status = 404;
const contact = page?.handle === 'contact';
---
<Store title={page?.title ?? 'Page not found'} noIndex={!page}>
  <section class="page">
    {contact && <div class="eyebrow">CUSTOMER SERVICE</div>}
    <h1 class="page-title">{page?.title ?? 'PAGE NOT FOUND'}</h1>
    {page ? <div class="description rte" set:html={safeHtml(page.body)} /> : <p><a href="/">Back to UNLISTED</a></p>}
    {['shipping', 'returns'].includes(page?.handle) && <p>For a delivered UNLISTED order, open it in <a href="/account">My account</a> to request a return or size exchange.</p>}
    {contact && <>
      <Notice success={Astro.url.searchParams.has('sent') ? 'Your message has been received.' : null} />
      <form method="post" action="/api/contact" id="contact_form" class="contact-form">
        <div class="form">
          <input required name="name" autocomplete="name" placeholder="Full name" aria-label="Full name" maxlength="100" />
          <input required type="email" name="email" autocomplete="email" placeholder="Email address" aria-label="Email address" maxlength="254" />
          <input type="tel" name="phone" autocomplete="tel" placeholder="Phone number" aria-label="Phone number" maxlength="24" />
          <textarea name="message" placeholder="How can we help?" aria-label="How can we help?" maxlength="3000" required></textarea>
          <input type="text" name="website" tabindex="-1" autocomplete="off" hidden />
        </div>
        <button class="btn" type="submit" style="width:100%;margin-top:18px">REQUEST A REPLY</button>
      </form>
      <div class="contact-links">
        <a href="mailto:unlisted.yh@gmail.com"><small>EMAIL</small>unlisted.yh@gmail.com</a>
        <a href="tel:01043116790"><small>PHONE</small>01043116790</a>
      </div>
    </>}
  </section>
</Store>
