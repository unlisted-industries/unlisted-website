---
import { env } from 'cloudflare:workers';
import Icon from './Icon.astro';
import { dashboard } from '../../lib/admin.js';
import { reportingRange } from '../../lib/reporting.js';
import { liveVisitors } from '../../lib/live-visitors.js';
import LiveVisitors from './LiveVisitors.astro';
import SalesChart from './SalesChart.astro';
import { workspaceSections } from '../../lib/admin-navigation.js';
import { getSettings } from '../../lib/catalog.js';
import { mediaUrl } from '../../lib/content.js';
import { ensureFinance } from '../../lib/finance-schema.js';

const reportUrl = new URL('/admin/analytics?days=all', Astro.url);
const range = reportingRange(reportUrl);
await ensureFinance(env.DB);
const [metrics, settings] = await Promise.all([dashboard(env.DB, range), getSettings(Astro, env.DB)]);
const activity = await liveVisitors(env.DB, settings.analytics_enabled).catch(() => ({ enabled: Boolean(settings.analytics_enabled), available: false, visitors: 0, countries: [], unknown: 0 }));
const hour = Number(new Intl.DateTimeFormat('en-GB', { timeZone: 'Africa/Cairo', hour: 'numeric', hourCycle: 'h23' }).format(new Date()));
const greeting = hour < 12 ? 'Good morning' : hour < 18 ? 'Good afternoon' : 'Good evening';
const tasks = [
  ['orders', 'Review orders', metrics.newOrders, '/admin/orders'],
  ['returns', 'Review return requests', metrics.newReturns, '/admin/returns'],
  ['products', 'Verify stock counts', metrics.unknownStock, '/admin/inventory'],
];
const poster = mediaUrl(settings.hero_poster);
---
<div class="workspace-home">
  <header class="workspace-heading">
    <div><p class="overline">YOUR STORE, AT A GLANCE</p><h1>{greeting}, UNLISTED.</h1><p>See what is happening, and how your store is growing.</p></div>
    <a class="button" href="/" target="_blank" rel="noopener">Open storefront ↗</a>
  </header>
  <div class="home-top">
    <SalesChart />
    <LiveVisitors activity={activity} />
  </div>
  <section class="panel home-next"><h2>Next up</h2><nav class="home-actions" aria-label="Store actions">
    {tasks.map(([icon, label, count, link]) => <a href={link}><Icon name={icon} />{label}<span>{count}</span></a>)}
  </nav></section>
  <section class="panel home-store">
    {poster && <img src={poster} alt="UNLISTED collection preview" loading="lazy" />}
    <div><p class="overline">ONLINE STORE</p><h2>See your storefront</h2>
      <a class="button" href="/" target="_blank" rel="noopener">Open storefront ↗</a>
    </div>
  </section>

  <h2>Business sections</h2>
  <nav class="workspace-grid" aria-label="Business sections">
    {workspaceSections.map(({ key, label, description }) => <a class="panel workspace-card" href={'/admin/' + key}>
      <span class="workspace-card-title"><Icon name={key} />{label}<Icon name="arrow" /></span><small>{description}</small>
    </a>)}
  </nav>
</div>
<style>
  .home-top { display: grid; grid-template-columns: minmax(0, 1fr) minmax(260px, 340px); gap: 18px; align-items: stretch; margin-bottom: 18px; }
  .home-top :global(.sales-chart) { margin-bottom: 0; }
  .home-next, .home-store { margin-bottom: 18px; }
  @media (max-width: 900px) { .home-top { grid-template-columns: 1fr; } }
</style>
