---
const { setup = false, token = '', requireCurrent = false } = Astro.props;
---
<form method="post" action="/admin/session" class="admin-form" data-owner-activation={setup ? '' : undefined}>
  <input type="hidden" name="action" value={setup ? 'setup-password' : 'save-password'} />
  {setup && <input type="hidden" name="token" value={token} />}
  {requireCurrent && <label>Current password <input name="current_password" type="password" autocomplete="current-password" maxlength="256" required /></label>}
  <label>New password <input name="password" type="password" autocomplete="new-password" minlength="15" maxlength="256" required /></label>
  <label>Confirm password <input name="password_confirmation" type="password" autocomplete="new-password" minlength="15" maxlength="256" required /></label>
  <button class="btn" type="submit" disabled={setup && !token}>{setup ? 'SET PASSWORD' : 'SAVE PASSWORD'}</button>
  {setup && <p class="muted" data-activation-help hidden={Boolean(token)}>Open your private owner setup link to activate this form.</p>}
</form>
