---
import MetricChange from './MetricChange.astro';
const { cards } = Astro.props;
---
<div class="metric-grid">
  {cards.map(([label, value, description, comparison]) => <article class="panel metric"><span>{label}</span><strong>{value}</strong>
    {comparison && <MetricChange {...comparison} />}<small>{description}</small></article>)}
</div>
