---
import { env } from 'cloudflare:workers';
import FinanceForm from './FinanceForm.astro';
import { ensureSimpleFinance,stockMetrics } from '../../lib/finance-simple.js';
import { makeToken } from '../../lib/db.js';
import { money } from '../../lib/content.js';
import { telegramReady } from '../../lib/order-notifications.js';
const {f}=Astro.props;
await ensureSimpleFinance(env.DB);
const plans=(await env.DB.prepare('SELECT * FROM finance_stock_plans ORDER BY updated_at DESC').all()).results;
const edit=plans.find(p=>p.id===Astro.url.searchParams.get('edit'));
const display=n=>n===null?'Add costs first':money(Math.round(n));
const fields=[{name:'name',label:'Stock name',value:edit?.name,placeholder:'For example: COZY — November'},
{name:'quantity',label:'How many pieces in this stock?',type:'number',min:1,max:1000000,value:edit?.quantity},
{name:'total_cost',label:'What did the whole stock cost? (EGP)',type:'number',min:0,max:1000000,step:'.01',value:edit?edit.total_cost/100:undefined},
{name:'price',label:'Selling price per piece (EGP)',type:'number',min:'.01',max:1000000,step:'.01',value:edit?edit.price/100:undefined}];
const extras=[['fees','Delivery you pay, extra packing & payment fees per piece (EGP)'],['ads','Planned ads for this stock (EGP)'],['pr_units','Pieces to give as PR'],['pr_cost','Total PR delivery & influencer fees (EGP)']];
const spend=f.campaigns.reduce((n,c)=>n+c.spend,0);
const sent=await env.DB.prepare("SELECT max(sent_at) FROM finance_telegram_outbox WHERE state='sent'").first('max(sent_at)');
---
<div class="finance-root simple-finance">
<p><a class="fin-button secondary" href="/admin/operations">Stocks, businesses & CPA planner</a> <a href="/admin/inventory">Stock management</a></p>
<header class="fin-header"><div><p class="fin-eyebrow">UNLISTED / FINANCE · EGP</p><h1>Know what your stock can make.</h1><p>Name your stock. Add its cost and price. See your numbers.</p></div><a class="fin-button" href="#add-stock">+ Add stock</a></header>
{Astro.url.searchParams.get('error')&&<p class="fin-error" role="alert">{Astro.url.searchParams.get('error')}</p>}
{Astro.url.searchParams.has('saved')&&<p class="fin-alert" role="status">Saved. Your numbers are up to date.</p>}
{!plans.length&&<section class="fin-panel"><h2>Start with one stock</h2><p>A stock is a batch of clothes you bought or made. You only need four things below.</p></section>}
{plans.map(p=>{const m=stockMetrics(p);const variants=f.variants.filter(v=>v.product_id===p.product_id);const verified=variants.length&&variants.every(v=>v.inventory!==null);return <section class="fin-panel stock-card">
<div class="fin-panel-heading"><h2>{p.name}</h2><a href={'/admin/finance?edit='+p.id+'#add-stock'}>Edit stock</a></div>
<p class="fin-muted">{p.quantity} pieces · Stock cost {money(p.total_cost)} · Selling for {money(p.price)} each</p>
<div class="fin-cards compact">
<article class="fin-stat"><span>Profit if it all sells</span><strong>{display(m.profit)}</strong><small>After this stock’s cost, planned ads, fees and PR. Before other business bills.</small></article>
<article class="fin-stat"><span>Break-even</span><strong>{m.canBreakEven?m.breakEvenUnits+' sales':'Cannot break even'}</strong><small>{m.canBreakEven?'Sales needed to cover the whole stock and your planned spending.':'Raise the price or reduce costs, ads or PR.'}</small></article>
<article class="fin-stat"><span>Break-even ROAS</span><strong>{m.breakEvenROAS===null?'No room for ads':m.breakEvenROAS.toFixed(2)+'×'}</strong><small>Your Meta ROAS needs to be higher than this to cover stock, PR and selling fees.</small></article>
</div>
<dl>
<div><dt>Cost per piece</dt><dd>{display(m.unitCost)}</dd></div>
<div><dt>Max CPA · ad cost per sale</dt><dd>{display(m.maxCPA)}</dd></div>
<div><dt>Lowest price to cover everything</dt><dd>{m.minimumPrice===null?'No pieces left to sell':display(m.minimumPrice)}</dd></div>
<div><dt>Ads limit if every sellable piece sells</dt><dd>{display(m.maxAds)}</dd></div>
<div><dt>PR limit with your planned ads</dt><dd>{m.maxPR} pieces total</dd></div>
{p.product_id&&<div><dt>Website stock · all batches of this product</dt><dd>{verified?variants.reduce((n,v)=>n+v.inventory,0)+' pieces':'Stock not verified yet'}</dd></div>}
</dl>
<p class="fin-muted">{p.pr_units} PR pieces planned · {m.available} pieces left to sell · Planned ads {money(p.ads)}. Ads and PR limits leave <strong>zero profit</strong> at full sellout. Spend less to keep a profit. These are estimates, not money in your bank. Ad metrics assume one piece per paid order and full sellout. Returns and discounts reduce what you can afford.</p>
</section>})}
<section class="fin-panel" id="add-stock"><h2>{edit?'Edit '+edit.name:'Add your stock'}</h2>
<form method="post" action="/admin/finance" class="fin-form">
<input name="request_id" type="hidden" value={makeToken(16)}/><input name="id" type="hidden" value={edit?.id||''}/><input name="revision" type="hidden" value={edit?.updated_at||0}/>
{fields.map(v=><label><span>{v.label}</span><input name={v.name} type={v.type||'text'} value={v.value} placeholder={v.placeholder} min={v.min} max={v.max} step={v.step} maxlength="80" required/></label>)}
<p class="fin-muted fin-full">Include all costs of making this stock: fabric, factory, packaging and delivery to you. Enter each cost once. Fees and ads left at zero are assumed to cost nothing.</p>
<details class="fin-full"><summary>Include ads, PR & selling fees (optional)</summary><div class="fin-form stock-extras">
{extras.map(([key,label])=><label><span>{label}</span><input name={key} type="number" min="0" max={key==='pr_units'?1000000:1000000} step={key==='pr_units'?'1':'.01'} value={edit?(key==='pr_units'?edit[key]:edit[key]/100):0} required/></label>)}
<label class="fin-full"><span>Link a website product (optional)</span><select name="product_id"><option value="">Choose later</option>{f.products.map(p=><option value={p.id} selected={edit?.product_id===p.id}>{p.title}</option>)}</select></label>
</div></details>
<p class="fin-muted fin-full">This saves your stock estimate. It does not add stock to your website or record another payment. Linked website stock updates with orders automatically; no daily stock counts.</p>
<label class="fin-check fin-full"><input type="checkbox" name="confirmed" value="yes" required/>These stock details are correct.</label>
<button>{edit?'Save changes':'Save stock & show my numbers'}</button>{edit&&<a href="/admin/finance">Cancel edit</a>}
</form></section>
<details class="fin-panel"><summary>My actual sales & ads</summary><p class="fin-muted">{f.range.current.startDate} to {f.range.current.endDate}. Stock estimates above are for the whole batch.</p>
<dl><div><dt>Collected sales after recorded refunds</dt><dd>{money(f.collected)}</dd></div><div><dt>Meta ad spend</dt><dd>{spend?money(spend):'No spend synced'}</dd></div><div><dt>Cash available after known bills</dt><dd>{f.safeAdvertisingBudget===null?'Add bank balances and costs first':money(f.safeAdvertisingBudget)}</dd></div></dl>
{f.campaigns.map(c=><article class="fin-alert"><strong>{c.name}</strong><p>Spend {money(c.spend)} · Meta CPA {c.cpa===null?'—':money(c.cpa)} · Meta ROAS {c.platformRoas?.toFixed(2)??'—'}×</p><p class="fin-muted">Meta’s attributed sales may include unpaid or returned orders. Actual linked collections: {money(c.collected)}.</p></article>)}
<a href="/admin/finance?tab=marketing">Connect or sync Meta</a></details>
<details class="fin-panel"><summary>Send a receipt or update my bank balance</summary><p>Send a note, receipt, bank statement or voice note. Your accountant asks you to check it before saving.</p><a class="fin-button secondary" href="/admin/finance?tab=accountant">Send to my accountant</a> <h3>Update bank or cash</h3><FinanceForm op="balance" fields={[{name:'account',label:'Which balance?',options:[['bank','Bank'],['cash','Cash']]},{name:'balance',label:'Actual balance (EGP)',type:'number',min:-1000000,max:1000000,step:'.01'},{name:'reported_on',label:'Date',type:'date',value:f.range.today,max:f.range.today},{name:'note',label:'Note (optional)',required:false}]} submit="Save balance"/></details>
<details class="fin-panel" id="phone-alerts"><summary>Phone alerts · Telegram</summary><p><strong>{telegramReady(env)?(sent?'Telegram delivery verified':'Bot configured — send a test below'):'Telegram is not connected yet'}</strong></p><ol><li>In Telegram, open the verified <a href="https://t.me/BotFather" target="_blank" rel="noreferrer">@BotFather</a>. Send <code>/newbot</code>, then choose a name and username.</li><li>Open your new bot and press <strong>Start</strong>.</li><li>In Cloudflare → unlisted-website → Settings → Variables and Secrets, save its token as the encrypted secret <code>TELEGRAM_BOT_TOKEN</code>. Save your Telegram chat ID as the encrypted secret <code>TELEGRAM_CHAT_ID</code>. Keep the token private.</li><li>Your chat ID is in your bot’s official <code>getUpdates</code> response, under <code>message.chat.id</code>, after you press Start. Do not share the token or its API URL.</li><li>Enable Telegram notifications on your phone and unmute this bot. Then send the test below.</li></ol><p class="fin-muted">The same bot sends new orders, the 9 PM Cairo bank reminder, and alerts when low stock or cash needs attention. Telegram works with the app closed. Daily reminder: {f.settings.daily_reminder?'on':'off'}.</p>
<FinanceForm op="test_reminder" tab="settings" submit="Send a test to my phone" note="Uses the configured Telegram bot and owner email."/>
<a href="/admin/finance?tab=settings">Change reminder settings</a></details>
</div>
<style>.simple-finance{max-width:1050px}.simple-finance .fin-header h1{font-size:clamp(27px,3vw,38px)}.simple-finance .fin-stat>span{text-transform:none;font-size:12px;letter-spacing:0}.simple-finance .fin-stat>small{font-size:11px}.simple-finance summary{font-size:14px;padding:4px 0}.stock-extras{margin-top:20px}.simple-finance .stock-card h2{font-size:21px}.simple-finance .fin-panel-heading a{font-size:12px;color:#356346}.simple-finance .fin-panel dl{font-size:13px}.simple-finance .fin-panel dt{color:#546357}.simple-finance .fin-panel li{font-size:13px}.simple-finance code{overflow-wrap:anywhere}@media(max-width:650px){.simple-finance .fin-cards.compact{grid-template-columns:1fr}.simple-finance .fin-panel dd{max-width:45%}}</style>
