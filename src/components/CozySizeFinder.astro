---
const { hoodie } = Astro.props;
const dimensions = hoodie
  ? [{ label: 'Chest width', sizes: [64, 65] }, { label: 'Body length', sizes: [61, 63] }]
  : [{ label: 'Waist width (unstretched)', sizes: [35, 37] }, { label: 'Inseam', sizes: [67, 69] }];
---

<details class="cozy-size-finder">
  <summary>Calculate my size</summary>
  <p>Lay a {hoodie ? 'hoodie' : 'pair of sweatpants'} that fits you well flat. Enter its measurements in centimeters to find the closest COZY size.</p>
  <form data-cozy-size-finder>
    {dimensions.map(({ label, sizes }) => <label>
      {label} (cm)
      <input type="number" inputmode="decimal" min="0.1" step="0.1" max="300" required data-small-medium={sizes[0]} data-large={sizes[1]} />
    </label>)}
    <button type="submit" class="btn">CALCULATE</button>
    <output aria-live="polite"></output>
  </form>
</details>

<style>
  .cozy-size-finder p { margin: 12px 0; }
  form { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  label { display: grid; align-content: end; gap: 6px; font-size: 13px; }
  input {
    width: 100%;
    min-width: 0;
    min-height: 44px;
    padding: 8px;
    border: 1px solid #aeb5c1;
    background: #fff;
    color: #0b1830;
    font: inherit;
  }
  button, output { grid-column: 1 / -1; }
  output { font-size: 14px; font-weight: 600; }
  output:empty { display: none; }
</style>
