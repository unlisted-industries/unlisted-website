---
import diagram from './cozy-hoodie-measurement.webp';

const measurements = [
  ['Length', 61, 63],
  ['Chest', 64, 65],
  ['Shoulder', 60, 62],
  ['Sleeve', 56, 56],
];
---

<div class="hoodie-chart">
  <img class="hoodie-chart-image" src={diagram.src} width={diagram.width} height={diagram.height}
    alt="Hoodie illustration showing where to measure shoulder, chest, body length and sleeve" loading="lazy" />
  <table>
    <caption>Garment measurements (cm)</caption>
    <thead><tr><th scope="col">Measurement</th><th scope="col">S/M</th><th scope="col">L</th></tr></thead>
    <tbody>
      {measurements.map(([label, smallMedium, large]) =>
        <tr><th scope="row">{label}</th><td>{smallMedium}</td><td>{large}</td></tr>
      )}
    </tbody>
  </table>
</div>

<style>
  .hoodie-chart {
    padding: 16px 0 0;
    background: #fff;
    color: #171717;
  }
  .hoodie-chart-image {
    display: block;
    width: 100%;
    max-width: 420px;
    height: auto;
    margin: 0 auto 16px;
  }
  table {
    width: 100%;
    margin: 0;
    border-collapse: collapse;
    font-size: 14px;
    font-variant-numeric: tabular-nums;
  }
  caption {
    padding: 0 0 12px;
    font-size: 13px;
    font-weight: 700;
    text-align: start;
    color: inherit;
  }
  th, td {
    padding: 10px 8px;
    border: 0;
    border-bottom: 1px solid #dedede;
    text-align: center;
    color: inherit;
    white-space: nowrap;
  }
  thead { border-top: 1px solid #242424; }
  th:first-child { text-align: start; padding-inline-start: 0; }
  th[scope="row"] { font-weight: 500; }
</style>
