---
const measurements = [
  ['Length', 61, 63],
  ['Chest', 64, 65],
  ['Shoulder', 60, 62],
  ['Sleeve', 56, 56],
];
---

<div class="hoodie-chart">
  <div class="hoodie-chart-photo">
    <img src="/media/shop/unlisted-cozy-hoodie-grey-1.webp" alt="Front view of the COZY Grey Hoodie" width="1000" height="1333" loading="lazy" />
    <div class="hoodie-chart-guides" aria-hidden="true">
      <span class="guide length"><span>1</span></span>
      <span class="guide chest"><span>2</span></span>
      <span class="guide shoulder"><span>3</span></span>
      <span class="guide sleeve"><span>4</span></span>
    </div>
  </div>
  <table>
    <caption>Garment measurements (cm)</caption>
    <thead><tr><th scope="col">Measurement</th><th scope="col">S/M</th><th scope="col">L</th></tr></thead>
    <tbody>
      {measurements.map(([label, smallMedium, large], index) =>
        <tr><th scope="row" data-point={index + 1}>{label}</th><td>{smallMedium}</td><td>{large}</td></tr>
      )}
    </tbody>
  </table>
</div>

<style>
  .hoodie-chart {
    padding: 16px 0 0;
    background: #fff;
    color: #171717;
  }
  .hoodie-chart-photo {
    position: relative;
    max-width: 420px;
    aspect-ratio: 420 / 370;
    margin: 0 auto 16px;
    background: #efefef;
    overflow: hidden;
  }
  img {
    position: absolute;
    inset: -24.32% 0 auto;
    display: block;
    width: 100%;
    height: auto;
    filter: grayscale(1);
  }
  .hoodie-chart-guides { position: absolute; inset: 0; }
  .guide {
    position: absolute;
    height: 1px;
    background: #242424;
    transform-origin: left center;
  }
  .guide::before, .guide::after {
    position: absolute;
    top: -3px;
    width: 1px;
    height: 7px;
    background: inherit;
    content: '';
  }
  .guide::before { left: 0; }
  .guide::after { right: 0; }
  .guide span {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border: 1px solid #242424;
    border-radius: 50%;
    background: #fff;
    font-size: 10px;
    font-weight: 700;
    transform: translate(-50%, -50%) rotate(calc(-1 * var(--angle, 0deg)));
  }
  .length {
    --angle: 90deg;
    left: 34%;
    top: 21%;
    width: 58%;
    transform: rotate(var(--angle));
  }
  .chest { left: 30%; top: 44%; width: 40%; }
  .shoulder { left: 27%; top: 31%; width: 46%; }
  .sleeve {
    --angle: 84deg;
    left: 75%;
    top: 32%;
    width: 55%;
    transform: rotate(var(--angle));
  }
  table {
    width: 100%;
    margin: 0;
    border-collapse: collapse;
    font-size: 14px;
    font-variant-numeric: tabular-nums;
  }
  caption {
    padding: 0 0 12px;
    font-size: 13px;
    font-weight: 700;
    text-align: start;
  }
  th, td {
    padding: 10px 8px;
    border: 0;
    border-bottom: 1px solid #dedede;
    text-align: center;
    white-space: nowrap;
  }
  thead { border-top: 1px solid #242424; }
  th:first-child { text-align: start; padding-inline-start: 0; }
  th[scope="row"] { font-weight: 500; }
  th[data-point]::before {
    display: inline-grid;
    place-items: center;
    width: 17px;
    height: 17px;
    margin-inline-end: 7px;
    border: 1px solid #666;
    border-radius: 50%;
    font-size: 10px;
    content: attr(data-point) / "";
  }
</style>
