---
import { offerDiscountLabel } from '../lib/offers.js';
const { original, current } = Astro.props;
const discount = offerDiscountLabel(original, current);
---
<span class="offer-price-tag offer-discount" data-offer-discount hidden={!discount}>{discount}</span>

<style>
  .offer-discount {
    inset-inline-end: auto;
    right: 12px;
    color: var(--red);
    font-size: 12px;
    font-weight: 800;
  }
  .offer-discount[hidden] { display: none; }
  @media (max-width: 640px) {
    .offer-discount { right: 6px; }
  }
</style>
