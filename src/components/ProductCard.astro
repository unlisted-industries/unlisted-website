---
import { mediaUrl, money } from '../lib/content.js';
const { product, eager = false } = Astro.props;
const url = product.preorder ? '/?preorder=' + product.handle : '/products/' + product.handle;
const image = product.images[0];
const catalogImages = {
  'shop/unlisted-cozy-fold-grey-1.png': '/theme/catalog/fold-over-grey-cutout-v2.png',
  'shop/unlisted-cozy-straight-grey-1.png': '/theme/catalog/straight-leg-grey-cutout.png',
};
const imageSource = catalogImages[image?.key] ?? mediaUrl(image?.key);
const price = product.variants.length ? Math.min(...product.variants.map((variant) => variant.price)) : null;
---
<a class="drop-card" href={url} data-category={product.category}>
  <div class="drop-card-image">
    {image && <img src={imageSource} alt={product.title} loading={eager ? 'eager' : 'lazy'} width="900" height="900" />}
  </div>
  {Boolean(product.preorder) && <span class="drop-badge">PRE-ORDER</span>}
  <h2>{product.title}</h2>
  {price !== null && <span class="drop-price">{money(price, true)}</span>}
</a>
