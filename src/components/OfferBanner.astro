---
import { blackFridayActive, saleStartsAt, saleEndsAt } from '../lib/offers.js';
const { now, lang } = Astro.props;
const active = blackFridayActive(now);
const boundary = active ? saleEndsAt : saleStartsAt;
const time = Math.max(0, Math.ceil((boundary - now) / 1000));
const clock = [Math.floor(time / 3600), Math.floor(time / 60) % 60, time % 60].map(value => String(value).padStart(2, '0'));
---
{now < saleEndsAt && <aside class="offer-banner" data-offer-clock data-now={now} data-boundary={boundary} aria-label="Black Friday">
  <a href="/offers">
    <span class="offer-banner-countdown">
      <strong class="offer-banner-title">{lang === 'ar' ? (active ? 'عرض البلاك فرايداي ينتهي خلال' : 'عرض البلاك فرايداي يبدأ خلال') : (active ? 'BLACK FRIDAY SALE ENDS IN' : 'BLACK FRIDAY SALE STARTS IN')}</strong>
      <time datetime={new Date(boundary).toISOString()} data-offer-time aria-label={active ? 'Offer ends November 29 at midnight Cairo time' : 'Offer starts November 27 at midnight Cairo time'}>{clock.map((digits, index) => <>{index > 0 && ':'}<span class="offer-banner-digits">{digits}</span></>)}</time>
    </span>
    <span class="offer-banner-link">{lang === 'ar' ? 'العروض' : 'Shop offers'} <span aria-hidden="true">↗</span></span>
  </a>
</aside>}
