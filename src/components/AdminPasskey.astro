---
const { mode } = Astro.props;
---
<div class="form" data-owner-passkey={mode}>
  <button type="button" class="button" disabled>{mode === 'register' ? 'Add a passkey' : 'Sign in with a passkey'}</button>
  <p class="muted" role="status" hidden></p>
</div>
<script>
  import { browserSupportsWebAuthn, startAuthentication, startRegistration } from '@simplewebauthn/browser';

  async function send(action, response) {
    const result = await fetch('/admin/passkey', {
      method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action, response }),
    });
    const payload = await result.json();
    if (!result.ok) throw new Error(payload.error ?? 'Passkey sign-in could not be completed.');
    return payload;
  }

  for (const group of document.querySelectorAll('[data-owner-passkey]')) {
    const button = group.querySelector('button');
    const message = group.querySelector('[role="status"]');
    if (!browserSupportsWebAuthn()) {
      message.textContent = 'Open the dashboard in a browser that supports passkeys.';
      message.hidden = false;
      continue;
    }
    button.disabled = false;
    button.addEventListener('click', async () => {
      const mode = group.getAttribute('data-owner-passkey');
      button.disabled = true;
      message.hidden = true;
      try {
        const optionsJSON = await send(mode + '-options');
        const response = mode === 'register'
          ? await startRegistration({ optionsJSON })
          : await startAuthentication({ optionsJSON });
        await send(mode + '-verify', response);
        if (mode === 'login') {
          location.assign('/admin');
          return;
        }
        message.textContent = 'Passkey saved. You can use it the next time you sign in.';
      } catch (error) {
        message.textContent = error instanceof Error ? error.message : 'Passkey setup could not be completed.';
      } finally {
        button.disabled = false;
        message.hidden = false;
      }
    });
  }
</script>
