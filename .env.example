# Local secrets belong in .dev.vars. Production secrets belong in the Worker.
# Use a verified sender for customer sign-in and order emails.
ADMIN_EMAILS=
# Exact HTTPS origin used by the owner dashboard.
ADMIN_ORIGIN=
EMAIL_FROM=
RESEND_API_KEY=
# Optional. Use Paymob test keys first. Values live only in Worker secrets.
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_INTEGRATION_IDS=
# Exact HTTPS origin used for Paymob callbacks. Set in the Worker for card checkout.
PAYMENT_ORIGIN=
# Enable only after merchant rates, inventory, and checkout are verified.
CHECKOUT_ENABLED=false
