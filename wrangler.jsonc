{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "unlisted-website",
  "account_id": "e9b1e1e2a83e75388d8fd84778fd5c78",
  "main": "./src/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "keep_vars": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "unlisted-store-staging",
      "database_id": "6fa7088a-3cf8-487d-a7ea-2d22ef04c490",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "unlisted-store-media" }],
  "durable_objects": { "bindings": [{ "name": "OWNER_PASSWORD_HASHER", "class_name": "OwnerPasswordHasher" }] },
  "migrations": [{ "tag": "owner-password-v1", "new_sqlite_classes": ["OwnerPasswordHasher"] }],
  "triggers": { "crons": ["*/15 * * * *"] }
}
