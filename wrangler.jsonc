{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "unlisted-website",
  "main": "./src/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "keep_vars": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "unlisted-store",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "unlisted-store-media" }],
  "durable_objects": { "bindings": [{ "name": "OWNER_PASSWORD_HASHER", "class_name": "OwnerPasswordHasher" }] },
  "migrations": [{ "tag": "owner-password-v1", "new_sqlite_classes": ["OwnerPasswordHasher"] }],
  "triggers": { "crons": ["*/15 * * * *"] }
}
